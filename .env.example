# SOGP Telegram
TELEGRAM_SOGP_BOT_TOKEN=
TELEGRAM_SOGP_BOT_USERNAME=
TELEGRAM_SOGP_CHANNEL_ID=
TELEGRAM_SOGP_CHANNEL_URL=
TELEGRAM_SOGP_WEBHOOK_SECRET=
TELEGRAM_SOGP_LINK_SECRET=
# Private ops chat for completed-enrolment alerts (not the public broadcast channel)
TELEGRAM_SOGP_SIGNUP_CHAT_ID=

# UploadThing (audio + community post images). Production reads this from Vercel;
# for local image upload copy the value from apps/web/.env into your .env.
UPLOADTHING_TOKEN=




# Dashboard connection rollout: leave disabled until migrations 0050–0052 and flows are verified.
DASHBOARD_DAILY_REPORTS_V2=0
DASHBOARD_CHURCH_V2=0
# Requires migration 0053; supports explicit multiple branches per Branch Pastor.
DASHBOARD_CHURCH_MULTI_BRANCH_V2=0
